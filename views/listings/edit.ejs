<% layout("/layouts/boilerplate") %>
<body>
    
    <div class="row mt-3">
        <div class="col-8 offset-2">
             <h3>Edit listing:<%=li.title%> </h3>
            <form action="/listings/<%= li._id %>?_method=put" method="post">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input value="<%= li.title %>" type="text" placeholder="enter title" name="listing[title]" class="form-control" >
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea type="text" placeholder="enter description" name="listing[description]" class="form-control"><%= li.description %></textarea>
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Image URL</label>
                <input value="<%= li.image ?li.image.url : li.image %>"  type="text" placeholder="enter image url/link" name="listing[image]" class="form-control">
                </div>
                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="price" class="form-label">Price</label>
                        <input  value="<%= li.price %>" type="number" placeholder="enter price" name="listing[price]" class="form-control" >
                    </div>
                    <div class="mb-3 col-md-6">
                        <label for="country" class="form-label">Country</label>
                        <input value="<%=li.country%>" type="text" placeholder="enter country" name="listing[country]" class="form-control">
                    </div>
                </div>
                
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                <input value="<%=li.location%>" type="text" placeholder="enter location" name="listing[location]" class="form-control">
                </div>
                <button class="btn btn-dark mt-3 mb-3 ">update</button>
            </form>
            
        </div>
    </div>
   
</body>
